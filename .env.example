# Backend LLM
# mock = chat sin API key (flujo determinista como demo.ts)
# openai = usa OpenAI; si OPENAI_API_KEY está vacía, cae en mock automáticamente
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MOCK_MODEL=deterministic-v1
# OPENAI_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_MS=90000

# Límites del agente (PRD)
AGENT_MAX_ITERATIONS=25
AGENT_MAX_TOKENS_PER_SESSION=100000

PORT=3000
CORS_ORIGIN=*

# Permite POST /api/demo/reset-out en producción (opcional, solo demo)
ALLOW_DEMO_RESET=true
